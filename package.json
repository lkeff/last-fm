{
  "name": "last-fm",
  "description": "Simple, robust LastFM API client (for public data) with enhanced security features",
  "version": "5.4.0",
  "author": {
    "name": "Feross Aboukhadijeh",
    "email": "feross@feross.org",
    "url": "https://feross.org"
  },
  "security": {
    "contact": "support@traycer.ai",
    "policy": "https://traycer.ai/security-policy"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "bugs": {
    "url": "https://github.com/feross/last-fm/issues"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/feross/last-fm.git"
  },
  "homepage": "https://github.com/feross/last-fm",
  "keywords": [
    "lastfm",
    "lastfm api",
    "lastfm data",
    "music",
    "music api",
    "music data",
    "last fm",
    "last fm api",
    "last fm data",
    "public data",
    "get",
    "data",
    "api",
    "last.fm",
    "last.fm api",
    "security",
    "html-sanitization",
    "url-validation",
    "encryption",
    "afk-guard",
    "studio-rig",
    "live-rig",
    "orchestra",
    "dj-booth",
    "audio-production",
    "south-american-orchestra",
    "andean",
    "tango",
    "afro-brazilian",
    "charango",
    "bandoneon",
    "claude-thinking"
  ],
  "license": "MIT",
  "main": "main.js",
  "type": "commonjs",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.56.0",
    "axios": "^1.13.2",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "discord.js": "^14.16.3",
    "dompurify": "^3.3.1",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "fft-js": "^0.0.12",
    "fiddle": "^0.0.1",
    "helmet": "^7.2.0",
    "keytar": "^7.9.0",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "node-cache": "^5.1.2",
    "run-parallel": "^1.2.0",
    "simple-get": "^4.0.1",
    "validator": "^13.15.26",
    "wav-decoder": "^1.3.0",
    "wav-encoder": "^1.3.0"
  },
  "devDependencies": {
    "dependency-check": "^4.1.0",
    "electron-builder": "^24.13.3",
    "eslint-plugin-security": "^1.7.1",
    "npm-audit-ci": "^1.2.1",
    "snyk": "^1.1301.2",
    "standard": "^17.1.2"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test:security": "eslint --ext .js --plugin security --rule \"security/detect-object-injection:warn\" .",
    "test:unit": "node --test test/*.test.js",
    "test": "npm run test:unit",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "security-audit": "npm audit && electron-builder --dir --config.nsis.oneClick=false",
    "build:secure": "npm run security-audit && npm run dist",
    "start:bot": "node bot.js",
    "start:node": "node get_top_music.js",
    "start:brass": "electron .",
    "debug:brass": "electron .",
    "start:fiddle": "electron . --fiddle",
    "debug:fiddle": "electron . --fiddle",
    "start:orchestra": "node -e \"const r=require('./rigs');console.log(JSON.stringify(r.getRigsSummary(),null,2))\"",
    "start:sa-orchestra": "node -e \"const r=require('./rigs/south-american-orchestra');console.log(JSON.stringify(r.getSAMusicianCount(),null,2))\""
  },
  "build": {
    "appId": "com.feross.lastfm",
    "productName": "LastFM Desktop",
    "forceCodeSigning": false,
    "directories": {
      "output": "dist"
    },
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "styles.css",
      "assets/**/*",
      "fiddle-templates/**/*"
    ],
    "extraResources": [
      {
        "from": ".",
        "to": "resources",
        "filter": [
          "!**/.env",
          "!**/*.env",
          "!**/.env.example",
          "!**/certs/**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "signingHashAlgorithms": [
        "sha256"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "identity": "Developer ID Application: Your Name (TEAMID)"
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    },
    "publish": {
      "provider": "generic",
      "url": "https://your-download-server.com/releases/"
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "keytar"
    ]
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/feross"
    },
    {
      "type": "patreon",
      "url": "https://www.patreon.com/feross"
    },
    {
      "type": "consulting",
      "url": "https://feross.org/support"
    }
  ]
}